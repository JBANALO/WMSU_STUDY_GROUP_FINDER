# Allow access to uploaded files
<IfModule mod_rewrite.c>
    RewriteEngine Off
</IfModule>

# Prevent directory listing
Options -Indexes

# Allow images and documents
<FilesMatch "\.(jpg|jpeg|png|gif|pdf|doc|docx|xls|xlsx|webp)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# Prevent PHP execution in uploads directory for security
<FilesMatch "\.php$">
    Order Deny,Allow
    Deny from all
</FilesMatch>
